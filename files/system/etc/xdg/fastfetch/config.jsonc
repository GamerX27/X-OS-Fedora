{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Force the Fedora logo explicitly rather than relying on auto-detection,
    // since PRETTY_NAME here is customized (see recipes/recipe.yml) and ID
    // stays "fedora" regardless - this just removes any doubt.
    "logo": {
        "type": "builtin",
        "source": "Fedora"
    }
}
