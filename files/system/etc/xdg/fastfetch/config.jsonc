{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 15,
        "width": 30,
        "padding": {
            "top": 5,
            "left": 3
        }
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "┌──────────────────────Hardware──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢  PC",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "green",
            "format": "{name} ({cores-logical}) @ {freq-max} - {temperature}",
            "temp": true
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "green",
            "format": "{name} [{type}] - {temperature}",
            "temp": true
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "green"
        },
        {
            "type": "disk",
            "key": "└ └󰋊 ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "┌──────────────────────Software──────────────────────┐"
        },
        {
            "type": "os",
            "key": "  OS",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "yellow"
        },
        {
            "type": "bios",
            "key": "│ ├󰖡 ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "yellow"
        },
        "break",
        {
            "type": "de",
            "key": "󰧨  DE",
            "keyColor": "blue"
        },
        {
            "type": "lm",
            "key": "│ ├󰍁 ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ ├󰉦 ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ ├󰆍 ",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "└ └ ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "┌───────────────────────Other────────────────────────┐"
        },
        {
            "type": "command",
            "key": "  ›  OS Age  ",
            "keyColor": "magenta",
            "text": "if [ -f /var/lib/x-os/install-date ]; then birth=$(date -d \"$(cat /var/lib/x-os/install-date)\" +%s 2>/dev/null); fi; if [ -n \"$birth\" ]; then echo \"$(( ($(date +%s) - birth) / 86400 )) days\"; else echo unknown; fi"
        },
        {
            "type": "uptime",
            "key": "  ›  Uptime  ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "  ›  DateTime  ",
            "keyColor": "magenta"
        },
        {
            "type": "media",
            "key": "  ›  Audio  ",
            "keyColor": "magenta"
        },
        {
            "type": "player",
            "key": "  ›  Player  ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "└────────────────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        }
    ]
}
